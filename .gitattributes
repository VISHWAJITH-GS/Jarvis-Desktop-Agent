# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.obj binary
*.bin binary
*.docx binary
*.db binary
*.sqlite binary
*.ttf binary
*.woff binary
*.woff2 binary
